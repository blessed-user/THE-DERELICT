# Demo funder seed: the PUBLIC BIP-39 spec test vector ("abandon" x23 + "art").
# Its first transparent address is zebrad's regtest miner address, so the
# coinbase reserve belongs to this wallet. Never use a real seed here.
ZECD_MNEMONIC=abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon art

# Blocks mined before z_shieldcoinbase (coinbase matures at 100).
BRINGUP_BLOCKS=105

# 1.0 = real phase clocks; set 0.25 for a quick demo run.
PHASE_SCALE=1
