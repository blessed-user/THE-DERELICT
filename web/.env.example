# Split deployment: the SPA on Vercel, the game server on Railway.
# Leave both values blank for same-origin development and the Docker image.
#
# API origin only: no trailing slash and no /api path.
VITE_API_BASE=
#
# Optional. Defaults to the WebSocket form of VITE_API_BASE
# (https://host -> wss://host). Set it only if the socket lives elsewhere.
VITE_WS_BASE=
